# Base URL for the audit platform API. With mocks enabled this is only a prefix
# that MSW intercepts, so it can stay relative.
VITE_API_BASE_URL=/api

# Serve every request from the MSW mock layer instead of a real backend.
# Keep this true until OQ-01 (data access + signed BAA) is resolved.
VITE_USE_MOCKS=true

# Shown in the top bar so nobody mistakes an environment for another.
VITE_ENV_LABEL=mock data
