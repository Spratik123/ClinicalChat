# Base URL for the audit platform API. In dev this is a same-origin prefix that
# the Vite proxy forwards to VITE_API_PROXY_TARGET + /python (the backend sends
# no CORS headers). In production point it at the deployed /python route.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://clinicchat-dev-alb-808006053.us-east-1.elb.amazonaws.com

# Mock the routes not yet integrated with the backend (see .env.development).
# Auth, /me, user admin and the access log always hit the real API.
VITE_USE_MOCKS=true

# Shown in the top bar so nobody mistakes an environment for another.
VITE_ENV_LABEL=dev api + mocks
