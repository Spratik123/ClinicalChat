# Same-origin prefix; the Vite dev proxy forwards /api -> <target>/python.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://clinicchat-dev-alb-808006053.us-east-1.elb.amazonaws.com

# Real backend: auth, current user, user admin, access log.
# Still mocked until their backend mapping lands: dashboard, review queue, turn
# detail, recommendations, reports, audit configuration, scheduler/runs.
VITE_USE_MOCKS=true
VITE_ENV_LABEL=dev api + mocks
